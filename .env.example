# Copier ce fichier en `.env` et compléter. `.env` n'est jamais commité.

# --- E-utilities NCBI ---------------------------------------------------
# Clé API NCBI (optionnelle). Sans clé : 3 requêtes/s. Avec clé : 10/s.
# À créer sur https://account.ncbi.nlm.nih.gov/settings/
NCBI_API_KEY=
# Identifiant d'outil et adresse de contact, exigés par l'étiquette E-utilities.
NCBI_TOOL=autopubmed
NCBI_EMAIL=ton.adresse@example.com

# --- OpenAlex -----------------------------------------------------------
# Adresse passée en `mailto` pour accéder au polite pool.
OPENALEX_MAILTO=ton.adresse@example.com

# --- Base de données ----------------------------------------------------
DB_PATH=data/veille.db

# --- Paramètres de rafraîchissement -------------------------------------
# Fenêtre de récence passée à esearch (`reldate`, avec datetype=edat), en jours.
REFRESH_RELDATE_DAYS=90
# Plafond de PMID rapportés par esearch et par requête.
ESEARCH_RETMAX=200

# --- Job de fond --------------------------------------------------------
# Laisser à 0 en développement : `uvicorn --reload` lance deux processus,
# le planificateur démarrerait donc deux fois.
ENABLE_SCHEDULER=0
# Intervalle entre deux passages du job de fond, en minutes.
SCHEDULER_INTERVAL_MINUTES=360

# --- Signalement des nouveautés -----------------------------------------
# Durée au-delà de laquelle rouvrir une requête compte pour une nouvelle
# session de lecture, et fait avancer le repère du badge « nouveau ». En deçà,
# recharger la liste n'efface pas les badges qu'on est en train de regarder.
VISIT_SESSION_GAP_MINUTES=30

# --- Résumé français par LLM local (Ollama) -----------------------------
# Ollama doit tourner sur la même machine : rien ne sort du serveur.
# Mettre à 0 pour retirer complètement la fonction de l'interface.
ENABLE_LLM_SUMMARY=1
OLLAMA_BASE_URL=http://localhost:11434
# Modèle utilisé. Un 4B quantisé Q4 tient sur ~4 Go de VRAM ; vérifier le débit
# réel avec `uv run python -m app.llm <PMID>` avant de changer.
OLLAMA_MODEL=qwen3.5:4b
# Un modèle construit par `ollama create` depuis un Modelfile avec directive
# SYSTEM est détecté automatiquement : l'application lui laisse son prompt.
# Plafond d'attente d'une génération, en secondes.
OLLAMA_TIMEOUT_SECONDS=180
# Fenêtre de contexte. Le pire cas réaliste — prompt système, titre, un long
# abstract structuré et la réponse — tient sous 1800 tokens ; 3072 laisse de la
# marge sans gonfler le cache KV. C'est le premier levier à baisser (2048) si le
# modèle déborde de la VRAM : vérifier avec `ollama ps` qu'il est à 100 % GPU.
OLLAMA_NUM_CTX=3072
# Durée pendant laquelle Ollama garde le modèle en mémoire entre deux clics.
OLLAMA_KEEP_ALIVE=5m

# --- Notation de pertinence ---------------------------------------------
# Notes 1–3 par requête, apprises pour trier et masquer les articles hors
# sujet. Mettre à 0 rend l'interface identique à ce qu'elle était avant la
# fonction ; les notes déjà données restent en base, intactes.
# Retrait complet (sauvegarde + export JSON des notes, puis suppression des
# tables) : uv run python -m app.relevance_admin --desinstaller
ENABLE_RELEVANCE=1
